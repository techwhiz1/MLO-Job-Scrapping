# OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Database URL (PostgreSQL)
DATABASE_URL=postgres://username:password@host:5432/dbname

# Environment: production, development, or leave empty for open mode
ENVIRONMENT=

# Selenium performance tuning
# Fast API mode defaults to 60s; deep mode defaults to 120s.
SELENIUM_HTTP_READ_TIMEOUT=60

# Skip slow parent-page scrolling for API calls. Iframe/listing scrolling still runs.
SKIP_MAIN_DOCUMENT_SCROLL=true

# Keep false for faster html_content rendering; set true only if a site lazy-loads detail content on scroll.
SCROLL_DETAIL_BEFORE_HTML=false
